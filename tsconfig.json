{
  "compilerOptions": {
    "target": "ES2020", // Specify ECMAScript target version
    "module": "Node16", // Generate JavaScript using ECMAScript 2020 (ES20) module syntax (import/export)
    "declaration": true,
    "allowJs": true, // Allow JavaScript files to be compiled
    "skipLibCheck": true, // Skip type checking of all declaration files
    "esModuleInterop": true, // Disables namespace imports (import * as fs from "fs") and enables CJS/AMD/UMD style imports (import fs from "fs")
    "strict": true, // Enable all strict type checking options
    "moduleResolution": "Node16", // Resolve modules using Node.js style
    "resolveJsonModule": true, // Include modules imported with .json extension
    "noEmit": false, // Do not emit output (meaning do not compile code, only perform type checking)
    "noUnusedLocals": true, // Report errors on unused locals
    "noUnusedParameters": true, // Report errors on unused parameters
    "noFallthroughCasesInSwitch": true, // Report errors for fallthrough cases in switch statement,
    "outDir": "dist", // Redirect output structure to the directory
    "sourceMap": true
  },
  "include": [
    "*.ts", // Include all TypeScript files under the 'src' directory and its subdirectories for type checking
  ],
  "exclude": ["./node_modules"] // *** The files to not type check ***
}
